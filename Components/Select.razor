@typeparam TItem

<div class="@Classes" @ref="_rootRef">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="combo-label">@Label</label>
    }

    @if (Clearable)
    {
        @* The clear button cannot sit inside the trigger <button> (nested buttons are invalid HTML),
           so the two are siblings in a wrapper and the clear button is laid over a spacer in the trigger. *@
        <div class="combo-trigger-wrapper">
            @TriggerButton
            @if (ShowClearValueButton)
            {
                <button type="button"
                        class="combo-clear combo-clear-value combo-adornment"
                        aria-label="@ClearButtonAriaLabel"
                        @onclick="ClearValueAsync">
                    @Clear
                </button>
            }
        </div>
    }
    else
    {
        @TriggerButton
    }

    @if (IsOpen)
    {
        <Portal Show="IsOpen" TriggerElementId="@_triggerId" Id="@PortalId" Width="@DropdownWidth" MinWidth="@DropdownMinWidth" MaxWidth="@DropdownMaxWidth" AnchorPosition="@AnchorPosition" MeasureClass="@DropdownClasses">
            <div class="combo-overlay" @onclick="CloseDropdown"></div>
            <div class="@DropdownClasses" @onmousedown:preventDefault>
                <div class="combo-content-container" id="@_listboxId" role="listbox" aria-labelledby="@AriaLabelledByOrNull" aria-multiselectable="@(MultiSelect ? "true" : null)">
                    @if (IsLoading)
                    {
                        @if (LoadingTemplate is not null)
                        {
                            <div class="combo-loading">@LoadingTemplate</div>
                        }
                        else
                        {
                            <div class="combo-loading">@LoadingText</div>
                            <div class="progress"></div>
                        }
                    }
                    else if (_loadError is not null)
                    {
                        <div class="combo-error">
                            @if (ErrorTemplate is not null)
                            {
                                @ErrorTemplate(ErrorContext)
                            }
                            else
                            {
                                <p style="margin: 8px auto; text-align: center">@ErrorText</p>
                            }
                        </div>
                    }
                    else if (ItemsList.Count == 0)
                    {
                        <div class="combo-no-results">
                            @if (NoResultsTemplate is null)
                            {
                                <p style="margin: 8px auto; text-align: center">@NoResultsText</p>
                            }
                            else
                            {
                                @NoResultsTemplate
                            }
                        </div>
                    }
                    else
                    {
                        @foreach (var item in ItemsList)
                        {
                            <div id="@GetOptionId(item)"
                                 role="option"
                                 aria-selected="@AriaSelected(item)"
                                 aria-disabled="@AriaDisabled(item)"
                                 class="@GetItemClasses(item)"
                                 @onclick="@(() => ItemClicked(item))">
                                <div class="combo-item-content select-item-content">
                                    @if (ShowCheckmarkInList && IsSelectedItem(item))
                                    {
                                        <span class="combo-checkmark combo-adornment">@CheckMark</span>
                                    }
                                    else if (ShowCheckmarkInList || ItemContentTemplate is null)
                                    {
                                        @* With ItemContentTemplate and ShowCheckmarkInList="false" the template owns the whole row. *@
                                        <span class="combo-checkmark combo-adornment" style="opacity: 0">@CheckMark</span>
                                    }

                                    @if (ItemContentTemplate is not null)
                                    {
                                        @ItemContentTemplate(ItemContext(item))
                                    }
                                    else if (ItemTemplate is not null)
                                    {
                                        @ItemTemplate(item)
                                    }
                                    else
                                    {
                                        <span>@GetItemString(item)</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
                @if (FooterTemplate is not null && !IsLoading)
                {
                    <div class="combo-footer">
                        @FooterTemplate
                    </div>
                }
                <div class="combo-sr-only" aria-live="polite">
                    @if (IsLoading)
                    {
                        <span>@LoadingAnnouncementText</span>
                    }
                    else if (_loadError is not null)
                    {
                        <span>@ErrorText</span>
                    }
                </div>
            </div>
        </Portal>
    }
</div>

@code {
    private RenderFragment TriggerButton =>
        @<button id="@_triggerId"
                 @ref="_triggerRef"
                 type="button"
                 class="@InputClasses"
                 role="combobox"
                 aria-haspopup="listbox"
                 aria-expanded="@(IsOpen ? "true" : "false")"
                 aria-controls="@_listboxId"
                 aria-label="@TriggerAriaLabel"
                 aria-labelledby="@AriaLabelledByOrNull"
                 aria-describedby="@AriaDescribedByOrNull"
                 aria-invalid="@TriggerAriaInvalid"
                 aria-busy="@TriggerAriaBusy"
                 @onclick="ToggleDropdown"
                 @onkeydown="HandleTriggerKeyDown">
            @if (StartContent is not null)
            {
                <span class="combo-start-content combo-adornment">@StartContent</span>
            }
            @if (MultiSelect && Values is { Count: > 0 })
            {
                <span class="combo-trigger-content">
                    <span class="combo-value">@MultiSelectionText</span>
                </span>
            }
            else if (!MultiSelect && Value is not null)
            {
                if (SelectedTemplate is not null)
                {
                    <span class="combo-trigger-content combo-selected-template">
                        @SelectedTemplate(Value!)
                    </span>
                }
                else
                {
                    <span class="combo-trigger-content">
                        <span class="combo-value">@GetItemString(Value)</span>
                    </span>
                }
            }
            else
            {
                <span class="combo-trigger-content">
                    <span class="combo-placeholder">@Placeholder</span>
                </span>
            }

            @if (Loading)
            {
                <span class="combo-spinner combo-adornment" aria-hidden="true">@Spinner</span>
            }
            @if (ShowClearValueButton)
            {
                @* Keeps room for the clear button, which is laid over this spot from outside the trigger. *@
                <span class="combo-clear-spacer" aria-hidden="true"></span>
            }
            <span class="combo-chevron combo-adornment">
                @(IsOpen ? ChevronUp : ChevronDown)
            </span>
        </button>;

    private RenderFragment CheckMark => @<svg xmlns="http://www.w3.org/2000/svg" height="16px" width="16px"
                                              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                              stroke-linejoin="round" class="lucide lucide-check-icon lucide-check">
                                            <path d="M20 6 9 17l-5-5"/>
                                        </svg>;

    private RenderFragment ChevronDown => @<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round" class="lucide lucide-chevron-down-icon lucide-chevron-down">
                                              <path d="m6 9 6 6 6-6"/>
                                          </svg>;

    private RenderFragment ChevronUp => @<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                              class="lucide lucide-chevron-up-icon lucide-chevron-up">
                                            <path d="m18 15-6-6-6 6"/>
                                        </svg>;

    private RenderFragment Spinner => @<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                            class="lucide lucide-loader-circle-icon lucide-loader-circle">
                                          <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                                      </svg>;

    private RenderFragment Clear => @<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                          class="lucide lucide-x-icon lucide-x">
                                        <path d="M18 6 6 18"/>
                                        <path d="m6 6 12 12"/>
                                    </svg>;
}
