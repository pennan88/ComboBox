@page "/"
@* Playground for the Select and Combobox options. Toggle the settings at the top and try the fields below. *@

<main class="demo">
    <h1>ComboBox – demo</h1>
    <p class="lead">Change the settings and try the fields. Events are logged at the bottom.</p>

    <section class="panel settings" aria-label="Settings">
        <h2>Settings (apply to every field)</h2>
        <div class="settings-grid">
            <label><input type="checkbox" @bind="_disabled" /> Disabled</label>
            <label><input type="checkbox" @bind="_invalid" /> Invalid (aria-invalid + error text)</label>
            <label><input type="checkbox" @bind="_loading" /> Loading (spinner in the trigger)</label>
            <label><input type="checkbox" @bind="_clearable" /> Clearable</label>
            <label><input type="checkbox" @bind="_startContent" /> StartContent (icon)</label>
            <label><input type="checkbox" @bind="_widthLimits" /> DropdownMinWidth 300px / MaxWidth 480px</label>
            <label><input type="checkbox" @bind="_highlightFirst" /> HighlightFirstItem</label>
            <label>
                AnchorPosition
                <select @bind="_anchor">
                    <option value="@DropdownAnchorPosition.Left">Left</option>
                    <option value="@DropdownAnchorPosition.Center">Center</option>
                    <option value="@DropdownAnchorPosition.Right">Right</option>
                </select>
            </label>
            <label>
                Field width
                <select @bind="_fieldWidth">
                    <option value="220px">220px</option>
                    <option value="320px">320px</option>
                    <option value="100%">100%</option>
                </select>
            </label>
        </div>
    </section>

    <div class="grid">
        @* ---------------- Select, single ---------------- *@
        <section class="panel">
            <h2>Select – single</h2>
            <p class="hint">Inactive people can be reached with the arrow keys but not picked. Rows with a description through <code>ItemContentTemplate</code>.</p>
            <div class="field" style="width:@_fieldWidth">
                <Select TItem="Person"
                        Items="@FewPeople"
                        @bind-Value="_selectPerson"
                        @bind-Value:after="@(() => Log($"Select: Value = {_selectPerson?.Name ?? "null"}"))"
                        ToStringFunc="@(p => p.Name)"
                        ItemDisabledFunc="@(p => p.Inactive)"
                        Label="Assignee"
                        Placeholder="Choose an assignee"
                        Disabled="_disabled"
                        Invalid="_invalid"
                        Loading="_loading"
                        Clearable="_clearable"
                        ClearButtonAriaLabel="Clear assignee"
                        OnClear="@(() => Log("Select: OnClear"))"
                        StartContent="@(_startContent ? UserIcon : null)"
                        AnchorPosition="_anchor"
                        DropdownMinWidth="@MinWidth"
                        DropdownMaxWidth="@MaxWidth">
                    <ItemContentTemplate Context="row">
                        <span class="row">
                            <span class="row-title">@row.Item.Name</span>
                            <span class="row-desc">@(row.IsDisabled ? InactiveText : row.Item.Team)</span>
                        </span>
                    </ItemContentTemplate>
                </Select>
            </div>
        </section>

        @* ---------------- Select, multi with Done ---------------- *@
        <section class="panel">
            <h2>Select – multiple with “Done”</h2>
            <p class="hint"><code>MultiSelect</code>, checkbox rows and a Done button in <code>FooterTemplate</code> that calls <code>CloseAsync()</code>.</p>
            <div class="field" style="width:@_fieldWidth">
                <Select @ref="_teamSelect"
                        TItem="string"
                        Items="@Teams"
                        MultiSelect="true"
                        @bind-Values="_teams"
                        @bind-Values:after="@(() => Log($"Select multiple: {string.Join(", ", _teams)}"))"
                        ShowCheckmarkInList="false"
                        Label="Teams"
                        Placeholder="Choose teams"
                        Disabled="_disabled"
                        Invalid="_invalid"
                        Loading="_loading"
                        Clearable="_clearable"
                        OnClear="@(() => Log("Select multiple: OnClear"))"
                        AnchorPosition="_anchor"
                        DropdownMinWidth="@MinWidth"
                        DropdownMaxWidth="@MaxWidth">
                    <ItemContentTemplate Context="row">
                        <span class="row-check">
                            <input type="checkbox" checked="@row.IsSelected" tabindex="-1" aria-hidden="true" />
                            @row.Item
                        </span>
                    </ItemContentTemplate>
                    <FooterTemplate>
                        <div class="footer-actions">
                            <button type="button" class="btn" @onclick="() => _teamSelect!.CloseAsync()">Done</button>
                        </div>
                    </FooterTemplate>
                </Select>
            </div>
        </section>

        @* ---------------- Combobox, static, external label ---------------- *@
        <section class="panel">
            <h2>Combobox – external label, FilterFunc, match highlighting</h2>
            <p class="hint">Search by name <em>or</em> email (<code>FilterFunc</code>). The match is marked with <code>SplitByMatch</code>. Escape with text clears the search first, then closes.</p>
            <div class="adapt-label-row">
                <span id="owner-label" class="adapt-label">Owner <span class="required">(required)</span></span>
                <button type="button" class="info" aria-label="More about the owner" title="The person responsible for the case">i</button>
            </div>
            <div class="field" style="width:@_fieldWidth">
                <Combobox TItem="Person"
                          StaticData="@AllPeople"
                          @bind-Value="_owner"
                          @bind-Value:after="@(() => Log($"Combobox: Value = {_owner?.Name ?? "null"}"))"
                          ToStringFunc="@(p => p.Name)"
                          FilterFunc="@MatchesNameOrEmail"
                          ItemDisabledFunc="@(p => p.Inactive)"
                          AriaLabelledBy="owner-label"
                          AriaDescribedBy="@OwnerDescribedBy"
                          Placeholder="Choose an owner"
                          SearchPlaceholder="Search name or email"
                          NoResultsText="No matches"
                          ResultCountTextFunc="@ResultCount"
                          ItemSize="52"
                          HighlightFirstItem="_highlightFirst"
                          Disabled="_disabled"
                          Invalid="_invalid"
                          Loading="_loading"
                          Clearable="_clearable"
                          ClearButtonAriaLabel="Clear owner"
                          OnClear="@(() => Log("Combobox: OnClear"))"
                          StartContent="@(_startContent ? UserIcon : null)"
                          AnchorPosition="_anchor"
                          DropdownMinWidth="@MinWidth"
                          DropdownMaxWidth="@MaxWidth">
                    <ItemContentTemplate Context="row">
                        <span class="row">
                            <span class="row-title">@Highlight(row, row.Item.Name)</span>
                            <span class="row-desc">
                                @if (row.IsDisabled)
                                {
                                    @InactiveText
                                }
                                else
                                {
                                    @Highlight(row, row.Item.Email)
                                }
                            </span>
                        </span>
                    </ItemContentTemplate>
                </Combobox>
            </div>
            <p id="owner-help" class="help">The person responsible for the case.</p>
            @if (_invalid)
            {
                <p id="owner-error" class="error">Choose an owner.</p>
            }
        </section>

        @* ---------------- Combobox, multi ---------------- *@
        <section class="panel">
            <h2>Combobox – multiple</h2>
            <p class="hint">The search stays after a pick, so you can pick more matches. The Done button closes.</p>
            <div class="field" style="width:@_fieldWidth">
                <Combobox @ref="_membersCombo"
                          TItem="Person"
                          StaticData="@AllPeople"
                          MultiSelect="true"
                          @bind-Values="_members"
                          @bind-Values:after="@(() => Log($"Combobox multiple: {_members.Count} selected"))"
                          ToStringFunc="@(p => p.Name)"
                          MultiSelectionTextFunc="@(v => v.Count == 1 ? v[0].Name : $"{v.Count} people")"
                          ItemDisabledFunc="@(p => p.Inactive)"
                          ShowCheckmarkInList="false"
                          Label="Participants"
                          Placeholder="Choose participants"
                          SearchPlaceholder="Search..."
                          ResultCountTextFunc="@ResultCount"
                          ItemSize="40"
                          HighlightFirstItem="_highlightFirst"
                          Disabled="_disabled"
                          Invalid="_invalid"
                          Loading="_loading"
                          Clearable="_clearable"
                          OnClear="@(() => Log("Combobox multiple: OnClear"))"
                          AnchorPosition="_anchor"
                          DropdownMinWidth="@MinWidth"
                          DropdownMaxWidth="@MaxWidth">
                    <ItemContentTemplate Context="row">
                        <span class="row-check">
                            <input type="checkbox" checked="@row.IsSelected" disabled="@row.IsDisabled" tabindex="-1" aria-hidden="true" />
                            <span>@Highlight(row, row.Item.Name)</span>
                        </span>
                    </ItemContentTemplate>
                    <FooterTemplate>
                        <div class="footer-actions">
                            <span>@_members.Count selected</span>
                            <button type="button" class="btn" @onclick="() => _membersCombo!.CloseAsync()">Done</button>
                        </div>
                    </FooterTemplate>
                </Combobox>
            </div>
        </section>

        @* ---------------- Combobox, DataProvider ---------------- *@
        <section class="panel wide">
            <h2>Combobox – DataProvider (loading and errors)</h2>
            <div class="settings-grid">
                <label><input type="checkbox" @bind="_simulateError" /> Make the provider throw</label>
                <label><input type="checkbox" @bind="_virtualize" /> Virtualize</label>
                <label><input type="checkbox" @bind="_useLoadingTemplate" /> LoadingTemplate instead of LoadingText</label>
                <label>
                    Delay
                    <select @bind="_delayMs">
                        <option value="0">0 ms</option>
                        <option value="400">400 ms</option>
                        <option value="1500">1500 ms</option>
                    </select>
                </label>
            </div>
            <p class="hint">With errors on, <code>ErrorTemplate</code> is shown; turn the error off and click “Try again” (<code>Retry</code>). <code>LoadingText="Searching..."</code> is shown on the first load.</p>
            <div class="field" style="width:@_fieldWidth">
                @* The key recreates the component when Virtualize changes, as it is not meant to change while mounted. *@
                <Combobox @key="_virtualize"
                          TItem="Person"
                          DataProvider="@SearchPeople"
                          Virtualize="_virtualize"
                          @bind-Value="_remotePerson"
                          @bind-Value:after="@(() => Log($"DataProvider: Value = {_remotePerson?.Name ?? "null"}"))"
                          ToStringFunc="@(p => p.Name)"
                          ItemDisabledFunc="@(p => p.Inactive)"
                          Label="Person (server)"
                          Placeholder="Search for a person"
                          SearchPlaceholder="Search..."
                          LoadingText="Searching..."
                          LoadingTemplate="@(_useLoadingTemplate ? CustomLoading : null)"
                          LoadingAnnouncementText="Loading results"
                          NoResultsText="No matches"
                          ErrorText="Could not load people."
                          ResultCountTextFunc="@ResultCount"
                          ItemSize="52"
                          HighlightFirstItem="_highlightFirst"
                          Disabled="_disabled"
                          Invalid="_invalid"
                          Loading="_loading"
                          Clearable="_clearable"
                          OnClear="@(() => Log("DataProvider: OnClear"))"
                          StartContent="@(_startContent ? UserIcon : null)"
                          AnchorPosition="_anchor"
                          DropdownMinWidth="@MinWidth"
                          DropdownMaxWidth="@MaxWidth">
                    <ItemContentTemplate Context="row">
                        <span class="row">
                            <span class="row-title">@Highlight(row, row.Item.Name)</span>
                            <span class="row-desc">@row.Item.Team · @row.Item.Email</span>
                        </span>
                    </ItemContentTemplate>
                    <ErrorTemplate Context="error">
                        <div class="error-row">
                            <span>Could not load people (@error.Exception.Message)</span>
                            <button type="button" class="btn" @onclick="error.Retry">Try again</button>
                        </div>
                    </ErrorTemplate>
                </Combobox>
            </div>
        </section>

        @* ---------------- Combobox, GroupBy with StaticData ---------------- *@
        <section class="panel wide">
            <h2>Combobox – GroupBy with StaticData</h2>
            <p class="hint">People grouped by team. <code>GroupBy</code> requires <code>Virtualize="false"</code> and a list that is already sorted by group. The arrow keys skip the group headers.</p>
            <div class="settings-grid">
                <label><input type="checkbox" @bind="_groupFooter" /> GroupFooterTemplate (count per group)</label>
            </div>
            <div class="field" style="width:@_fieldWidth">
                <Combobox TItem="Person"
                          StaticData="@PeopleByTeam"
                          GroupBy="@(p => p.Team)"
                          Virtualize="false"
                          PageSize="@PeopleByTeam.Count"
                          @bind-Value="_groupedPerson"
                          @bind-Value:after="@(() => Log($"GroupBy: Value = {_groupedPerson?.Name ?? "null"} ({_groupedPerson?.Team})"))"
                          ToStringFunc="@(p => p.Name)"
                          FilterFunc="@MatchesNameOrEmail"
                          ItemDisabledFunc="@(p => p.Inactive)"
                          Label="Person by team"
                          Placeholder="Choose a person"
                          SearchPlaceholder="Search name or email"
                          NoResultsText="No matches"
                          ResultCountTextFunc="@ResultCount"
                          HighlightFirstItem="_highlightFirst"
                          Disabled="_disabled"
                          Invalid="_invalid"
                          Loading="_loading"
                          Clearable="_clearable"
                          OnClear="@(() => Log("GroupBy: OnClear"))"
                          StartContent="@(_startContent ? UserIcon : null)"
                          AnchorPosition="_anchor"
                          DropdownMinWidth="@MinWidth"
                          DropdownMaxWidth="@MaxWidth"
                          GroupFooterTemplate="@(_groupFooter ? GroupCount : null)">
                    <GroupHeaderTemplate Context="team">
                        <span class="group-header">@team</span>
                    </GroupHeaderTemplate>
                    <ItemContentTemplate Context="row">
                        <span class="row">
                            <span class="row-title">@Highlight(row, row.Item.Name)</span>
                            <span class="row-desc">
                                @if (row.IsDisabled)
                                {
                                    @InactiveText
                                }
                                else
                                {
                                    @Highlight(row, row.Item.Email)
                                }
                            </span>
                        </span>
                    </ItemContentTemplate>
                </Combobox>
            </div>
        </section>
    </div>

    <section class="panel log" aria-label="Event log">
        <h2>Events <button type="button" class="btn small" @onclick="() => _log.Clear()">Clear</button></h2>
        @if (_log.Count == 0)
        {
            <p class="hint">Nothing yet.</p>
        }
        <ol reversed>
            @foreach (var entry in _log)
            {
                <li>@entry</li>
            }
        </ol>
    </section>
</main>

@code {
    private const string InactiveText = "Inactive – cannot be picked";

    private static readonly List<Person> AllPeople = Person.All.ToList();
    private static readonly List<Person> FewPeople = Person.All.Take(12).ToList();
    // GroupBy renders a header whenever the key changes, so the list must be sorted by group.
    private static readonly List<Person> PeopleByTeam = Person.All.OrderBy(p => p.Team).ThenBy(p => p.Name).ToList();
    private static readonly List<string> Teams = ["Finance", "Sales", "IT", "Support", "Management", "HR"];

    private bool _disabled;
    private bool _invalid;
    private bool _loading;
    private bool _clearable = true;
    private bool _startContent;
    private bool _widthLimits;
    private bool _highlightFirst = true;
    private DropdownAnchorPosition _anchor = DropdownAnchorPosition.Left;
    private string _fieldWidth = "320px";

    private bool _simulateError;
    private bool _virtualize = true;
    private bool _useLoadingTemplate;
    private int _delayMs = 400;

    private Person? _selectPerson;
    private IReadOnlyList<string> _teams = [];
    private Person? _owner;
    private IReadOnlyList<Person> _members = [];
    private Person? _remotePerson;
    private Person? _groupedPerson;
    private bool _groupFooter;

    private static readonly RenderFragment<ComboGroupContext<Person>> GroupCount = group =>
        @<span class="group-footer">@group.Items.Count in @group.Key</span>;

    private Select<string>? _teamSelect;
    private Combobox<Person>? _membersCombo;

    private readonly List<string> _log = [];

    private string? MinWidth => _widthLimits ? "300px" : null;
    private string? MaxWidth => _widthLimits ? "480px" : null;
    private string OwnerDescribedBy => _invalid ? "owner-help owner-error" : "owner-help";

    private void Log(string message) => _log.Insert(0, $"{DateTime.Now:HH:mm:ss} {message}");

    // Announced to screen readers only (aria-live); shows how ResultCountTextFunc localizes the count.
    private static string ResultCount(int n) => n == 1 ? "1 match" : $"{n} matches";

    private static bool MatchesNameOrEmail(Person person, string search) =>
        person.Name.Contains(search, StringComparison.CurrentCultureIgnoreCase) ||
        person.Email.Contains(search, StringComparison.CurrentCultureIgnoreCase);

    private async ValueTask<ItemsProviderResult<Person>> SearchPeople(ComboState state, CancellationToken token)
    {
        if (_delayMs > 0)
            await Task.Delay(_delayMs, token);

        if (_simulateError)
            throw new HttpRequestException("503 Service Unavailable");

        var matches = AllPeople
            .Where(p => string.IsNullOrWhiteSpace(state.Search) || MatchesNameOrEmail(p, state.Search))
            .ToList();

        return new ItemsProviderResult<Person>(matches.Skip(state.Skip).Take(state.Take), matches.Count);
    }

    private static RenderFragment Highlight<T>(ComboItemContext<T> row, string text) => builder =>
    {
        var sequence = 0;
        foreach (var part in row.SplitByMatch(text))
        {
            if (part.IsMatch)
            {
                builder.OpenElement(sequence++, "mark");
                builder.AddContent(sequence++, part.Text);
                builder.CloseElement();
            }
            else
            {
                builder.AddContent(sequence++, part.Text);
            }
        }
    };

    private static readonly RenderFragment UserIcon =
        @<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
        </svg>;

    private static readonly RenderFragment CustomLoading =
        @<span class="custom-loading">⏳ Fetching people from the server…</span>;
}
