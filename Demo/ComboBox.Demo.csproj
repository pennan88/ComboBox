<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- A playground for trying the Select and Combobox options by hand. Not packed.
       Blazor WebAssembly, so it can be hosted as static files on GitHub Pages (.github/workflows/demo-pages.yml). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ComboBox.csproj" />
  </ItemGroup>

</Project>
